{
  "name": "icebase",
  "version": "0.1.0",
  "description": "Firebase's API with an explicit schema, declared composite indexes and a self-hostable emulator.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panth977/icebase.git",
    "directory": "packages/icebase"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./dist/admin.js"
    },
    "./app": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./auth/server": {
      "types": "./src/auth-server.ts",
      "default": "./dist/auth-server.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./database": {
      "types": "./src/database.ts",
      "default": "./dist/database.js"
    },
    "./firestore": {
      "types": "./src/firestore.ts",
      "default": "./dist/firestore.js"
    },
    "./functions": {
      "types": "./src/functions.ts",
      "default": "./dist/functions.js"
    },
    "./functions/v2": {
      "types": "./src/functions-v2.ts",
      "default": "./dist/functions-v2.js"
    },
    "./manage": {
      "types": "./src/manage.ts",
      "default": "./dist/manage.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./dist/storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": ">=14",
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "firebase-functions": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "firebase-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "bin": {
    "icebase": "./dist/cli/index.js"
  }
}
